#!/usr/bin/env bash
set -Eeuo pipefail

APP="devin-rc"
VERSION="1.5.0"
SESSION_DEFAULT="devin"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/devin-rc"
CONFIG_FILE="$CONFIG_DIR/config"

# Environment variables win over the saved config; capture them before sourcing.
ENV_SESSION="${SESSION:-}"
ENV_REMOTE="${REMOTE:-}"
ENV_DEVIN_CMD="${DEVIN_CMD:-}"

SESSION="$SESSION_DEFAULT"
REMOTE=""
REMOTE_MODE="posix"
REMOTE_DISTRO=""
DEVIN_CMD="devin"
SSH_OPTS=(-o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=2)

red(){ printf '\033[31m%s\033[0m\n' "$*" >&2; }
green(){ printf '\033[32m%s\033[0m\n' "$*"; }
yellow(){ printf '\033[33m%s\033[0m\n' "$*"; }
die(){ red "Error: $*"; exit 1; }
exists(){ command -v "$1" >/dev/null 2>&1; }

load_config() {
  if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
  fi
  SESSION="${ENV_SESSION:-${SESSION:-$SESSION_DEFAULT}}"
  REMOTE="${ENV_REMOTE:-${REMOTE:-}}"
  DEVIN_CMD="${ENV_DEVIN_CMD:-${DEVIN_CMD:-devin}}"
}

save_config() {
  mkdir -p "$CONFIG_DIR"
  (
    umask 077
    cat > "$CONFIG_FILE" <<CFG
REMOTE=$(printf '%q' "${REMOTE:-}")
REMOTE_MODE=$(printf '%q' "${REMOTE_MODE:-posix}")
REMOTE_DISTRO=$(printf '%q' "${REMOTE_DISTRO:-}")
SESSION=$(printf '%q' "${SESSION:-$SESSION_DEFAULT}")
DEVIN_CMD=$(printf '%q' "${DEVIN_CMD:-devin}")
CFG
  )
}

# tmux forbids ':' and '.' in session names; restricting to a safe charset also
# keeps the remote ssh command quoting-trivial.
validate_session() {
  [[ "$SESSION" =~ ^[a-zA-Z0-9_-]+$ ]] \
    || die "Invalid session name '$SESSION' (allowed: letters, digits, - and _)"
}

need() {
  exists "$1" || die "Missing '$1'. $2"
}

# DEVIN_CMD may include arguments (e.g. "devin --model x"); check its binary.
need_devin() {
  need "${DEVIN_CMD%%[[:space:]]*}" "Install Devin CLI: curl -fsSL https://cli.devin.ai/install.sh | bash"
}

install_tmux_macos() {
  if exists tmux; then return 0; fi
  need brew "Install Homebrew first: https://brew.sh — then: brew install tmux"
  yellow "Installing tmux with brew..."
  brew install tmux
}

install_tmux_linux() {
  if exists tmux; then return 0; fi
  if exists apt-get; then
    yellow "Installing tmux with apt..."
    sudo apt-get update -qq
    sudo apt-get install -y tmux
  elif exists dnf; then
    yellow "Installing tmux with dnf..."
    sudo dnf install -y tmux
  elif exists yum; then
    yellow "Installing tmux with yum..."
    sudo yum install -y tmux
  elif exists pacman; then
    yellow "Installing tmux with pacman..."
    sudo pacman -S --noconfirm tmux
  else
    die "tmux is required and no supported package manager was found."
  fi
}

host_setup() {
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) die "On Windows use the PowerShell version: devin-rc.ps1 (run install.ps1; see README, Windows)." ;;
    Linux)  install_tmux_linux ;;
    Darwin) install_tmux_macos ;;
    *) die "setup-host supports Linux and macOS hosts. Clients can be macOS or Linux." ;;
  esac
  need tailscale "Install Tailscale and sign in first: https://tailscale.com/download"
  need_devin

  if ! tailscale status >/dev/null 2>&1; then
    die "Tailscale is installed but not connected. Run 'sudo tailscale up' and sign in."
  fi

  yellow "Enabling Tailscale SSH on this PC..."
  # Requires the standalone tailscaled build; the macOS App Store app has no SSH server.
  sudo tailscale set --ssh \
    || die "Could not enable Tailscale SSH. On macOS use the standalone Tailscale (https://tailscale.com/download/macos or 'brew install tailscale'), not the App Store build."

  local ip user
  ip="$(tailscale ip -4 | head -n1)"
  user="$(id -un)"
  [[ -n "$ip" ]] || die "Could not determine this PC's Tailscale IP."

  REMOTE="$user@$ip"
  save_config

  green "Host ready."
  printf '\nOn your laptop, install devin-rc and run:\n\n  devin-rc pair %s\n  devin-rc connect\n\n' "$REMOTE"
  printf 'Remote target: %s\n' "$REMOTE"
}

pair_client() {
  local target="" mode="posix" distro=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --wsl) mode="wsl"; shift ;;
      --distro)
        [[ $# -ge 2 && "$2" != -* ]] || die "--distro requires a name"
        distro="$2"; shift 2 ;;
      --distro=*) distro="${1#--distro=}"; shift ;;
      -*) die "Unknown flag '$1' for pair" ;;
      *)
        [[ -z "$target" ]] || die "Usage: devin-rc pair user@HOST [--wsl] [--distro NAME]"
        target="$1"; shift ;;
    esac
  done
  [[ -n "$target" ]] || die "Usage: devin-rc pair user@HOST [--wsl] [--distro NAME]"
  [[ "$target" != *[[:space:]]* ]] \
    || die "Invalid target '$target' (expected: user@HOST or HOST)"
  [[ -z "$distro" || "$distro" =~ ^[a-zA-Z0-9_.-]+$ ]] \
    || die "Invalid distro name '$distro'"
  REMOTE="$target"; REMOTE_MODE="$mode"; REMOTE_DISTRO="$distro"
  save_config
  green "Saved remote: $REMOTE ($mode host${distro:+, distro $distro})"
}

start_devin() {
  need tmux "Run 'devin-rc setup-host' on the main PC first."
  need_devin
  local project="${1:-$PWD}"
  [[ -d "$project" ]] || die "Project directory does not exist: $project"
  project="$(cd "$project" && pwd)"

  if tmux has-session -t "$SESSION" 2>/dev/null; then
    green "Attaching to existing Devin session '$SESSION'."
    if [[ "${IN_UI:-}" == 1 ]]; then tmux attach-session -t "$SESSION"; return; fi
    exec tmux attach-session -t "$SESSION"
  fi

  green "Starting Devin in persistent session '$SESSION' at $project"
  if [[ "${IN_UI:-}" == 1 ]]; then tmux new-session -s "$SESSION" -c "$project" "$DEVIN_CMD"; return; fi
  exec tmux new-session -s "$SESSION" -c "$project" "$DEVIN_CMD"
}

start_background() {
  need tmux "Run 'devin-rc setup-host' on the main PC first."
  need_devin
  local project="${1:-$PWD}"
  [[ -d "$project" ]] || die "Project directory does not exist: $project"
  project="$(cd "$project" && pwd)"

  if tmux has-session -t "$SESSION" 2>/dev/null; then
    green "Devin session '$SESSION' is already running."
    return 0
  fi

  tmux new-session -d -s "$SESSION" -c "$project" "$DEVIN_CMD"
  green "Started Devin session '$SESSION' in background at $project"
}

# One-liners executed by the remote host's default shell. POSIX hosts get a sh
# pipeline; Windows (WSL) hosts get a cmd.exe line because that is the default
# shell of the Windows OpenSSH server.
remote_distro_flag() {
  if [[ -n "$REMOTE_DISTRO" ]]; then printf -- '-d %s ' "$REMOTE_DISTRO"; fi
}

remote_attach_cmd() {
  local s="$SESSION" d
  if [[ "$REMOTE_MODE" == "wsl" ]]; then
    d="$(remote_distro_flag)"
    printf 'wsl.exe %s-e tmux has-session -t %s 2>nul && wsl.exe %s-e tmux attach-session -t %s || echo Devin RC session is not running. On the main PC run: devin-rc start <project>' "$d" "$s" "$d" "$s"
  else
    printf "command -v tmux >/dev/null || { echo 'tmux missing on host'; exit 1; }; tmux has-session -t '%s' 2>/dev/null || { echo 'Devin RC session is not running. On the main PC run: devin-rc start <project>'; exit 2; }; exec tmux attach-session -t '%s'" "$s" "$s"
  fi
}

remote_state_cmd() {
  local s="$SESSION" d
  if [[ "$REMOTE_MODE" == "wsl" ]]; then
    d="$(remote_distro_flag)"
    printf 'wsl.exe %s-e tmux has-session -t %s 2>nul && echo RUNNING || echo STOPPED' "$d" "$s"
  else
    printf "if command -v tmux >/dev/null && tmux has-session -t '%s' 2>/dev/null; then echo RUNNING; else echo STOPPED; fi" "$s"
  fi
}

remote_ls_cmd() {
  if [[ "$REMOTE_MODE" == "wsl" ]]; then
    printf 'wsl.exe %s-e tmux ls' "$(remote_distro_flag)"
  else
    printf 'command -v tmux >/dev/null && tmux ls 2>/dev/null || true'
  fi
}

connect_remote() {
  local target="${1:-${REMOTE:-}}"
  [[ -n "$target" ]] || die "No main PC paired. Run: devin-rc pair user@HOST"
  need ssh "An SSH client is required."

  green "Connecting to $target → tmux session '$SESSION'"
  if [[ "${IN_UI:-}" == 1 ]]; then ssh -t "${SSH_OPTS[@]}" "$target" "$(remote_attach_cmd)"; return; fi
  exec ssh -t "${SSH_OPTS[@]}" "$target" "$(remote_attach_cmd)"
}

iphone_help() {
  [[ -n "${REMOTE:-}" ]] || die "No main PC paired. Run: devin-rc pair user@HOST"
  local attach host user
  attach="$(remote_attach_cmd)"
  if [[ "$REMOTE" == *@* ]]; then
    user="${REMOTE%%@*}"; host="${REMOTE##*@}"
  else
    host="$REMOTE"; user="$(id -un)"
  fi
  cat <<EOF

iPhone setup
  1. Install Tailscale (App Store) and sign in to the same tailnet.
  2. Install an SSH app — Blink Shell is the best tmux client (real Ctrl key);
     Termius and the free iSH emulator also work.
  3. Paste this command into the SSH app:

  ssh -t ${SSH_OPTS[*]} $REMOTE "$attach"

One-tap connect via the Shortcuts app: action "Run script over SSH" with
  Host: $host    Port: 22    User: $user
  Script: $attach

iSH can even run this client natively: apk add openssh-client, then use
devin-rc pair / connect inside iSH.

Detach without stopping Devin: Ctrl-b, then d (Blink shows Ctrl on its bar).
EOF
}

status_cmd() {
  if exists tmux && tmux has-session -t "$SESSION" 2>/dev/null; then
    green "LOCAL  RUNNING   session=$SESSION"
    tmux list-clients -t "$SESSION" 2>/dev/null || true
  else
    printf 'LOCAL  STOPPED   session=%s\n' "$SESSION"
  fi

  if [[ -n "${REMOTE:-}" ]]; then
    if ! exists ssh; then
      printf 'REMOTE UNKNOWN   host=%s (no ssh client)\n' "$REMOTE"
      return 0
    fi
    local out
    if out="$(ssh "${SSH_OPTS[@]}" -o BatchMode=yes "$REMOTE" \
      "$(remote_state_cmd)" 2>/dev/null)"; then
      printf 'REMOTE %-9s host=%s session=%s\n' "$out" "$REMOTE" "$SESSION"
    else
      printf 'REMOTE UNREACHABLE host=%s\n' "$REMOTE"
    fi
  fi
}

stop_local() {
  need tmux "tmux is not installed."
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux kill-session -t "$SESSION"
    green "Stopped session '$SESSION'."
  else
    printf 'Session %s is not running.\n' "$SESSION"
  fi
}

list_sessions() {
  printf '%s\n' "-- local --"
  if exists tmux; then
    tmux ls 2>/dev/null || printf '(none)\n'
  else
    printf 'tmux not installed\n'
  fi
  if [[ -n "${REMOTE:-}" ]]; then
    printf '%s\n' "-- $REMOTE --"
    if exists ssh; then
      ssh "${SSH_OPTS[@]}" -o BatchMode=yes "$REMOTE" "$(remote_ls_cmd)" \
        || printf '(unreachable)\n'
    else
      printf '(no ssh client)\n'
    fi
  fi
}

show_info() {
  printf 'session: %s\n' "$SESSION"
  if [[ -n "${REMOTE:-}" ]]; then
    printf 'remote:  %s (%s host%s)\n' "$REMOTE" "${REMOTE_MODE:-posix}" "${REMOTE_DISTRO:+, distro $REMOTE_DISTRO}"
  else
    printf 'remote:  <not paired>\n'
  fi
  printf 'devin:   %s\n' "$DEVIN_CMD"
  printf 'config:  %s\n' "$CONFIG_FILE"
  printf 'version: %s\n' "$VERSION"
}

ui_help() {
  cat <<'TXT'
Slash commands:
  /status              local + remote session status
  /ls                  list local + remote tmux sessions
  /connect [host]      attach to the remote Devin terminal (detach returns here)
  /start [dir]         start or attach to the local session
  /bg [dir]            start the local session detached
  /stop                stop the local session
  /pair TGT [--wsl] [--distro NAME]
  /session NAME        switch active session (letters, digits, -, _)
  /info                show saved config
  /iphone              iPhone connect instructions
  /quit                exit (also: q, exit, Ctrl-d)
TXT
}

interactive_ui() {
  printf '%s %s — interactive shell. /help for commands, /quit to exit.\n' "$APP" "$VERSION"
  IN_UI=1
  while true; do
    local line
    IFS= read -erp "$(printf '\033[36mdevin-rc:%s>\033[0m ' "$SESSION")" line \
      || { printf '\n'; break; }
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" ]] && continue
    set -- ${line#/}
    # commands run in subshells so a die() returns to the prompt instead of
    # killing the shell; /session and /pair need main-shell persistence
    case "${1:-}" in
      help|h|\?)    ui_help ;;
      quit|q|exit)  break ;;
      status)       ( status_cmd ) || true ;;
      ls|sessions)  ( list_sessions ) || true ;;
      info)         ( show_info ) || true ;;
      session|use)  if [[ -n "${2:-}" ]]; then
                      if ( SESSION="$2"; validate_session ); then SESSION="$2"; fi
                    else printf 'session: %s\n' "$SESSION"; fi ;;
      connect|c)    ( connect_remote "${2:-}" ) || true ;;
      start)        ( start_devin "${2:-}" ) || true ;;
      bg|background) ( start_background "${2:-}" ) || true ;;
      stop)         ( stop_local ) || true ;;
      pair)         shift || true; if ( pair_client "$@" ); then load_config; fi ;;
      iphone|ios|mobile) ( iphone_help ) || true ;;
      version)      printf '%s %s\n' "$APP" "$VERSION" ;;
      *)            printf "unknown command '%s' — try /help\n" "$line" ;;
    esac
  done
  printf 'bye\n'
}

usage() {
  cat <<'TXT'
devin-rc — persistent remote control for Devin CLI

MAIN PC
  devin-rc setup-host           One-time Tailscale SSH + tmux setup (Linux/macOS host)
  devin-rc start [project]      Start Devin or attach to the existing session
  devin-rc bg [project]         Start Devin detached
  devin-rc status               Show local + remote session status
  devin-rc stop                 Stop the local Devin session

LAPTOP
  devin-rc pair user@HOST [--wsl] [--distro NAME]
                              Save the main PC's address (HOST alone uses your
                              local username; --wsl: the host is Windows with
                              Devin in WSL; --distro: its WSL distro name)
  devin-rc connect [user@HOST]  Attach to the exact persistent Devin terminal
  devin-rc iphone               iPhone (iOS) connect instructions + command
  devin-rc ui                   Interactive shell (/status /connect /pair ...)

OTHER
  devin-rc ls                   List local and remote tmux sessions
  devin-rc info                 Show saved target/session
  devin-rc version              Print version
  devin-rc help                 Show this help

OPTIONS (before the command)
  -s, --session NAME            Use session NAME (default: devin)
                                Letters, digits, - and _ only

Multiple sessions: run each project under its own name, e.g.
  devin-rc -s web bg ~/code/web
  devin-rc -s api bg ~/code/api
  devin-rc -s web connect

Detach without stopping Devin: Ctrl-b, then d
TXT
}

load_config
while [[ "${1:-}" == -* ]]; do
  case "$1" in
    -s|--session)
      [[ $# -ge 2 && "$2" != -* ]] || die "$1 requires a session name"
      SESSION="$2"; shift 2 ;;
    -V|--version)
      printf '%s %s\n' "$APP" "$VERSION"; exit 0 ;;
    -h|--help)
      usage; exit 0 ;;
    *) die "Unknown flag '$1'. Run: devin-rc help" ;;
  esac
done
validate_session
cmd="${1:-help}"
shift || true
case "$cmd" in
  setup-host) host_setup "$@" ;;
  pair) pair_client "$@" ;;
  start) start_devin "$@" ;;
  bg|background) start_background "$@" ;;
  connect|c) connect_remote "$@" ;;
  iphone|ios|mobile) iphone_help "$@" ;;
  ui|tui|shell)    interactive_ui ;;
  status) status_cmd "$@" ;;
  stop) stop_local "$@" ;;
  ls|sessions) list_sessions "$@" ;;
  info) show_info "$@" ;;
  version) printf '%s %s\n' "$APP" "$VERSION" ;;
  help) usage ;;
  *) die "Unknown command '$cmd'. Run: devin-rc help" ;;
esac
